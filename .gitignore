data/bts_flight_data/

# Generated Load Test Scenarios (regenerate with generate_flight_scenarios.py)
flight_test_scenarios.json


# Environment & Credentials
# Ignore every .env variant (.env.backup, .env.local, .env.bak, .envrc, ...).
# A bare ".env" line matches only that exact name, which is how .env.backup
# was committed with a real password in 81edc69.
.env
.env.*
.envrc
*.env
# Re-allow the committed placeholder template (must contain no real secrets)
!.env.example
*.log

# Logs Directory
logs/

# Conda environment (use environment.yml to recreate)
.conda/
**/envs/neo4j-flight-schedule/

# Neo4j Server Reports
neo4j_server_*/
*.zip

